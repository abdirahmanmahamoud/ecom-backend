
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleType {
  USER
  ADMIN
}

model User {
  id        String @id @default(uuid())
  name      String
  email     String @unique
  phone     Int?
  password  String
  role      RoleType @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  image       String
  imageKey    String

  CreatedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}